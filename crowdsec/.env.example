# =======================================================
# CROWDSEC (detection engine + firewall bouncer)
# =======================================================
CROWDSEC_CONTAINER_NAME=crowdsec
CROWDSEC_FIREWALL_BOUNCER_CONTAINER_NAME=crowdsec-firewall-bouncer

# Host interface IP binding for the Local API and the Prometheus collector
# (e.g. 10.40.0.10, 127.0.0.1, or the host's Tailscale IP).
# Use the TAILSCALE IP on every host: the bouncer reaches the LAPI at this IP
# from host networking, and crowdsec-dashboard on OCI-Core reads LAPI :8080 and
# metrics :6060 over the tailnet. Nothing here is meant to face the internet.
HOST_IP=changeme

# Optional override; if unset the bouncer uses http://<HOST_IP>:8080.
# CROWDSEC_LAPI_URL=http://127.0.0.1:8080

# Shared API key between the engine and the firewall bouncer. The engine
# registers the bouncer as "firewall" with this key on startup.
# Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=changeme

# Optional: the CrowdSec web Console (the "dashboard"). Create an enroll key
# at https://app.crowdsec.net and paste it here; empty = no console.
# Trade-off: alert context is shared with the CrowdSec cloud (the CAPI
# blocklist feed already talks to it unless DISABLE_ONLINE_API is set).
# Leaving this empty is the point of the self-hosted dashboard in the sibling
# crowdsec-dashboard/ stack. It does NOT affect the CAPI community blocklist,
# which each engine pulls regardless. Never set DISABLE_ONLINE_API unless you
# knowingly give up that blocklist.
# CROWDSEC_ENROLL_KEY=
# CROWDSEC_ENROLL_INSTANCE_NAME=oci-core

# Name this host's local agent as shown in crowdsec-dashboard (the image default
# "localhost" makes two hosts indistinguishable). Use oci-core / oci-production.
CROWDSEC_CUSTOM_HOSTNAME=oci-core

# SQLite write-ahead logging: lets the dashboard poll the LAPI without blocking
# engine writes. Safe on local filesystems (all state dirs here are bind mounts).
CROWDSEC_USE_WAL=true

# Collections installed at startup (space separated). whitelist-good-actors is a
# postoverflow whitelist (crawlers, resolvers, monitors); it does not taint Hub
# scenarios, so CAPI signal contribution -- and blocklist tier -- is unaffected.
# On OCI-Production drop nginx-proxy-manager (there is no nginx there).
CROWDSEC_COLLECTIONS=crowdsecurity/linux crowdsecurity/sshd crowdsecurity/nginx-proxy-manager crowdsecurity/whitelist-good-actors

# External DNS for the container. On OCI the VCN resolver (169.254.169.254)
# is unreachable from containers, so a reachable resolver is required.
# Defaults: 1.1.1.1 / 8.8.8.8. To keep lookups local point DNS_PRIMARY at
# your AdGuard (host-networked), e.g. this host's Tailscale IP:
# DNS_PRIMARY=100.93.103.16
# DNS_SECONDARY=1.1.1.1
