# SnapOtter -- self-hosted file-processing stack (image, video, audio, PDF)
#
# Setup:
#   1. cp .env.example .env && fill in every "changeme" below. All three
#      passwords are real secrets. Generate with:
#          openssl rand -hex 32
#      (SNAPOTTER_ADMIN_PASSWORD is a real login password, so a password
#      manager fits better than a raw hex string. Changing POSTGRES_PASSWORD
#      after first boot does not change the existing database.)
#   2. docker compose up -d
#   3. Log in as admin and change the admin password immediately.
HOST_IP=changeme

SNAPOTTER_CONTAINER_NAME=snapotter
SNAPOTTER_PORT=1349

SNAPOTTER_ADMIN_PASSWORD=changeme
SKIP_MUST_CHANGE_PASSWORD=false

POSTGRES_USER=snapotter
POSTGRES_PASSWORD=changeme
POSTGRES_DB=snapotter
POSTGRES_APP_USER=snapotter_app
POSTGRES_APP_PASSWORD=changeme

REDIS_PASSWORD=changeme
