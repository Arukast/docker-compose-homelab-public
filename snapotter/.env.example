# SnapOtter -- self-hosted file-processing stack (image, video, audio, PDF)
#
# Setup:
#   1. cp .env.example .env && fill in every "changeme" below. All three
#      passwords are real secrets. Generate with:
#          openssl rand -hex 32
#      (SNAPOTTER_ADMIN_PASSWORD is a real login password, so a password
#      manager fits better than a raw hex string. Changing POSTGRES_PASSWORD
#      after first boot does not change the existing database.)
#   2. docker compose up -d
#   3. Log in as admin and change the admin password immediately.
HOST_IP=changeme

SNAPOTTER_CONTAINER_NAME=snapotter
SNAPOTTER_PORT=1349

# Auth
AUTH_ENABLED=false
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=changeme
SKIP_MUST_CHANGE_PASSWORD=false
SESSION_DURATION_HOURS=168

# Config
MAX_UPLOAD_SIZE_MB=100
MAX_BATCH_SIZE=1
MAX_PIPELINE_STEPS=20
RATE_LIMIT_PER_MIN=100
TRUST_PROXY=loopback,linklocal,uniquelocal

# Database
POSTGRES_USER=snapotter
POSTGRES_PASSWORD=changeme
POSTGRES_DB=snapotter
REDIS_PASSWORD=changeme


# AI Features Installation
INSTALL_STALL_MS=7200000
INSTALL_MAX_MS=0
HF_HUB_ENABLE_HF_TRANSFER=0
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60

# OIDC
# EXTERNAL_URL="https://photos.example.com"
# OIDC_ENABLED="true"
# OIDC_ISSUER_URL="https://auth.example.com/realms/myrealm"
# OIDC_CLIENT_ID="snapotter"
# OIDC_CLIENT_SECRET="your-secret-here"
