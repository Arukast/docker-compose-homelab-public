# First running this command in shell to make the network: docker network create ai-net
HOST_IP=changeme

OPENWEBUI_CONTAINER_NAME=open-webui
OPENAI_API_BASE_URL=http://litellm-proxy:4000/v1
# litellm-proxy's LITELLM_MASTER_KEY (sk-...). Not OmniRoute's key.
LITELLM_API_KEY=changeme
# Embeddings run IN-PROCESS in this container via sentence-transformers, not in
# the separate embedder stack. bge-m3 is the smallest model that handles
# Indonesian well, and it would not fit on an 11GB LXC as a separate TEI
# container. Weights land in ./open-webui-data/cache/embedding on first boot.
RAG_EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>



