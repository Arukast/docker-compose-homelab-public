# First running this command in shell to make the network: docker network create ai-net
HOST_IP=changeme

OPENWEBUI_CONTAINER_NAME=open-webui
OPENAI_API_BASE_URL=http://litellm-proxy:4000/v1
# litellm-proxy's LITELLM_MASTER_KEY (sk-...). Not OmniRoute's key.
LITELLM_API_KEY=changeme
# Embeddings. bge-m3 runs in the separate embedder stack (TEI), not here.
# MUST equal the embedder's --model-id: open-webui sends this as the "model"
# field to TEI, which only answers for the name it was launched with.
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# TEI has no auth. open-webui requires the var to exist, so it is a placeholder.
RAG_EMBEDDING_OPENAI_API_KEY=not-needed
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
