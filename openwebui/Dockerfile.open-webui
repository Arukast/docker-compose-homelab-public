# Patches CVE-2026-68770: a critical arbitrary-code-execution bug in
# sentence-transformers <=5.5.1 that triggers on local model load even
# with trust_remote_code=False. Upgrading is required regardless of
# which embedding model you use.
FROM ghcr.io/open-webui/open-webui:v0.12.3@sha256:a537bbe1e6b428820f52ed4a029d7fff97062e24d5cf32c365fba36fd0542def

RUN pip install --no-cache-dir --upgrade "sentence-transformers>5.5.1"
