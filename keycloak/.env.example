# First run these commands in shell to make the networks
# (docker network create takes ONE name at a time):
#   docker network create npm-net
# =======================================================
# KEYCLOAK (OIDC / SAML / LDAP identity provider)
# =======================================================
# Setup:
#   1. cp .env.example .env, then replace every "changeme" below -- the comment
#      above each variable says how.
#   2. docker compose up -d
#      First boot runs the quarkus build plus schema migration, so give it a
#      minute before the container reports healthy.
#   3. In NPM add a Proxy Host for the hostname in KEYCLOAK_HOSTNAME, forwarding
#      to keycloak:8080 over npm-net, with Websockets Support ON (the admin
#      console needs it) and Block Common Exploits ON.
#   4. Log in at https://<keycloak hostname>/admin.
#
# Nothing is stored on this host's disk: realms, clients, users and keys live in
# the postgres container's ./postgresql directory. Back that directory up and
# you have the whole instance.
#
# This stack is independent of authentik/. Running both is fine; point each
# client at one of them, not both.

# Unset, Keycloak's :8080 binds 127.0.0.1 so nothing is exposed by accident.
# Set the host's LAN IP only if something other than NPM reaches keycloak
# directly -- NPM itself does not need this, it uses npm-net.
HOST_IP=changeme

# Optional container name override. The database container is named
# "<this>-postgres".
KEYCLOAK_CONTAINER_NAME=keycloak

# --- Public URL --------------------------------------------------------------
# Full URL clients use, scheme included. This becomes the OIDC issuer claim, so
# it must be exactly what the browser sees: https, no trailing slash, no port
# unless NPM is published on a non-standard one.
# Changing it later invalidates every issued token -- clients have to be
# reconfigured and users have to log in again. Get it right before creating any
# client or realm.
KEYCLOAK_HOSTNAME=https://sso.example.com

# --- Secrets -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
# (hex avoids the / + = characters that .env and shell quoting mangle.)

# Password for the initial admin account. Keycloak reads this only when the
# master realm does not exist yet, i.e. on the first start against an empty
# database; after that it is ignored, so changing the password in the admin UI
# is safe and permanent. Keep the value anyway -- rebuilding the database
# without it leaves the instance with no admin, and recovery is a CLI command.
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=changeme

# Postgres password for the identity database. A real login credential: a
# password manager is a better fit than raw hex if you use one. Changing it
# after first boot does not change the existing database -- you have to ALTER
# ROLE by hand.
PG_PASS=changeme

# --- Bootstrap admin ---------------------------------------------------------
# Username of the initial admin account. Not a secret; just pick one.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin

# --- Database ----------------------------------------------------------------
PG_USER=keycloak
PG_DB=keycloak
