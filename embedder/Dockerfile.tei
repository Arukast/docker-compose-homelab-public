# TEI with bge-m3 baked in.
#
# Why build instead of `image:` + download-at-boot: shared-ai-backend-net is
# created with --internal, so a RUNNING container on it has no route out
# ("Network is unreachable") and cannot resolve huggingface.co at all. `docker
# build` does not use that network -- it runs on the default bridge, where
# resolution works. So the weights are fetched here, at build time, and the
# runtime container never needs the internet.
#
# Why a builder stage: the TEI image is Rust (text-embeddings-router) and has no
# python3, so huggingface_hub cannot be run in it. Download in a python image,
# then COPY the result across. The final image carries no python.
#
# Cost: ~2.3GB added to the image. The payoff is that the container keeps
# internal-only network isolation and has no bootstrap step -- no manual
# snapshot_download, no half-populated cache that only works if the previous run
# got far enough.
FROM python:3.12-slim AS model-fetch

# Install in a layer of its own so the (large) pip cache is not re-downloaded
# when only the snapshot step changes.
RUN pip install --no-cache-dir --quiet huggingface_hub transformers

# Verify the snapshot BEFORE it gets copied into the final image. A truncated
# download would otherwise surface as a crash-loop hours later, and the cause
# is not obvious from TEI's startup logs.
RUN python3 -c "\
from huggingface_hub import snapshot_download; \
snapshot_download('BAAI/bge-m3', local_dir='/model')" \
 && python3 -c "\
from transformers import AutoTokenizer, AutoConfig; \
AutoTokenizer.from_pretrained('/model'); \
AutoConfig.from_pretrained('/model'); \
print('model files verified')"

FROM ghcr.io/huggingface/text-embeddings-inference:cpu-1.8

# --model-id points at this local directory, which TEI accepts instead of a Hub
# id. Everything else in the compose command stays the same.
COPY --from=model-fetch /model /model
