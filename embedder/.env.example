# Embedder (TEI + bge-m3)
# Copy to .env and adjust. Not read by other stacks.

TEI_CONTAINER_NAME=text-embeddings-inference

# English + Indonesian, 1024-dim, 8192-token context.
# Swap for intfloat/multilingual-e5-large (1024-dim, 512-token) if you need
# shorter documents, or nomic-ai/nomic-embed-text-v1.5 (768-dim, English-only
# despite the name -- it will underperform on Indonesian).
EMBED_MODEL=BAAI/bge-m3
