# First running this command in shell to make the network: docker network create --internal shared-ai-backend-net
HOST_IP=changeme

PRESIDIO_ANALYZER_CONTAINER_NAME=presidio-analyzer
# Server config (nlp engine) and recognizer registry are SEPARATE files. Setting
# ANALYZER_CONF_FILE to the registry file makes the server fall back to the
# image's conf/default.yaml for nlp settings.
# The registry var is RECOGNIZER_REGISTRY_CONF_FILE. ANALYZER_REGISTRY_CONF_FILE
# is not read by the image and is silently ignored -- the registry then falls
# back to conf/default_recognizers.yaml and custom recognizers never load.
ANALYZER_CONF_FILE=/app/config/analyzer-config.yaml
RECOGNIZER_REGISTRY_CONF_FILE=/app/config/secret_recognizers.yaml

PRESIDIO_ANONYMIZER_CONTAINER_NAME=presidio-anonymizer
