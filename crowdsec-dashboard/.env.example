# First running this command in shell to make the network: docker network create npm-net
# =======================================================
# CROWDSEC DASHBOARD (self-hosted replacement for app.crowdsec.net)
# Deploy on OCI-Core only; it reads both LAPIs. It never changes which IPs are
# blocked -- the CAPI community blocklist is pulled by each engine, not by this
# UI -- and decisions stay per-host because the two LAPIs are independent.
#
# Replace CORE_HOST_IP with this host's Tailscale IP, PROD_TAILSCALE_IP with
# OCI-Production's, and every "changeme".
# =======================================================
CROWDSEC_WEBUI_CONTAINER_NAME=crowdsec-web-ui

# Host interface IP binding (Tailscale IP). Direct access: http://<HOST_IP>:3000
# The normal entry point is the npm vhost: https://crowdsec.<domain>:8443
HOST_IP=changeme

# Machine name registered on BOTH LAPIs (see crowdsec/AGENTS.md). One password
# per instance; generate each with: openssl rand -hex 32
CROWDSEC_WEBUI_LAPI_USERNAME=crowdsec-web-ui

# Instance 0 = OCI-Core LAPI/METRICS (local, through the published ports).
CROWDSEC_WEBUI_LAPI_0_URL=http://CORE_HOST_IP:8080
CROWDSEC_WEBUI_LAPI_0_PASSWORD=changeme
CROWDSEC_WEBUI_METRICS_0_URL=http://CORE_HOST_IP:6060/metrics

# Instance 1 = OCI-Production LAPI/METRICS, over the tailnet.
CROWDSEC_WEBUI_LAPI_1_URL=http://PROD_TAILSCALE_IP:8080
CROWDSEC_WEBUI_LAPI_1_PASSWORD=changeme
CROWDSEC_WEBUI_METRICS_1_URL=http://PROD_TAILSCALE_IP:6060/metrics

# Optional: authentik OIDC (the UI supports it natively). Leave commented out
# until an OAuth2 provider/application exists in authentik; then set the
# unmatched-role fallback and pin the admin group too.
# CONFIG_AUTH_OIDC_ISSUER_URL=https://authentik.<domain>/application/o/crowdsec/
# CONFIG_AUTH_OIDC_CLIENT_ID=crowdsec-web-ui
# CONFIG_AUTH_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# CONFIG_AUTH_OIDC_UNMATCHED_ROLE=deny
