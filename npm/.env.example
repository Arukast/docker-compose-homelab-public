# First running this command in shell to make the network: docker network create npm-net && docker network create cloudflared-net
NPM_CONTAINER_NAME=npm

# Router listener host ports. Leave unset on every host that serves
# local/cloudflared traffic directly (defaults: 80/443). ONLY on the OCI
# edge host, where npm-front owns the public 80/443, set e.g.:
# NPM_HTTP_PORT=8088
# NPM_HTTPS_PORT=8443
# (NOT 8080 -- that is crowdsec's LAPI port on the edge host.)
