# Secret config (contains Telegram webhook URL)
.env
setup.conf
power_homelab.conf
docs/
dashboard/homarr

# Editor / OS
*.swp
*.swo
*~
.DS_Store

# Runtime state: chat database, uploaded files, and the ~8GB embedding model
# cache. Never commit these. Pipe functions live under functions/ inside this
# tree and ARE committed -- they are source, not state.
openwebui/open-webui-data/*
!openwebui/open-webui-data/functions/

# Runtime state: crowdsec seeds its config, SQLite DB and hub datafiles here
# on first boot. Never commit. crowdsec/crowdsec/acquis.d/ is source and IS
# committed.
crowdsec/crowdsec/config/
crowdsec/crowdsec/data/

# Get ignored for now because the workflows is not supported
glances/glances/glances.conf
.commandcode
