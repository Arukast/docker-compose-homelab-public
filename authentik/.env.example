# Authentik -- identity provider (SSO / OIDC / LDAP / forward proxy)
#
# Setup:
#   1. docker network create npm-net
#   2. cp .env.example .env && fill it in -- every "changeme" below is a real
#      value you must replace, and the comment above each one says how
#   3. docker compose up -d
#   4. Open http://<host>:9000/if/flow/initial-setup/ once to create the first
#      (non-bootstrap) admin, then blank AUTHENTIK_BOOTSTRAP_PASSWORD below.
#   5. Set the authentik URL to https://auth.example.com/ in the admin UI
#      before creating any OAuth provider, or the issuer claim in issued
#      tokens will not match what your clients expect.
#
# The bootstrap account is created by the migration on first boot only, and is
# skipped entirely once an admin exists. Leaving the password set after setup
# is a standing credential, not a safety net.

AUTHENTIK_CONTAINER_NAME=authentik

# --- Secrets -----------------------------------------------------------------
# All three below are secrets. Generate with:
#     openssl rand -hex 32
# (openssl rand -base64 32 also works, but hex avoids the / + = characters that
# .env and shell quoting mangle. There is no length requirement here; entropy
# is what matters. See the per-variable notes for the ones that differ.)

# Machine secret used to sign and encrypt internal tokens. Rotating it
# invalidates every session, token and encrypted value in ./data -- it is not
# recoverable afterwards, so only change it deliberately.
# Generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=changeme

# Postgres user password. This one is a real login credential, so a password
# manager is a better fit than a raw hex string if you use one anywhere else.
# Generate with: openssl rand -hex 32   (or: openssl rand -base64 24)
# Changing it after first boot does not change the existing database -- you
# have to ALTER ROLE by hand.
PG_USER=authentik
PG_PASS=changeme
PG_DB=authentik

# --- First admin -------------------------------------------------------------
# Read once, by the initial migration only. These are NOT secrets to rotate,
# they are values you must fill in.
# AUTHENTIK_BOOTSTRAP_EMAIL is a plain email address.
# AUTHENTIK_BOOTSTRAP_PASSWORD is a real password for a real admin account, so
# pick something you would actually type, or generate one with
# openssl rand -base64 16 -- but keep it in your password manager, because
# deleting it after setup is the only way to retire the bootstrap account.
AUTHENTIK_BOOTSTRAP_EMAIL=changeme
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme

# --- Networking --------------------------------------------------------------
# Unset, the UI binds 127.0.0.1 so nothing is exposed by accident. Set the
# host's LAN IP only if something other than the cloudflared tunnel reaches
# authentik directly.
HOST_IP=

# Networks whose forwarded headers authentik is allowed to believe. This is the
# npm-net subnet, i.e. the only thing that connects to server:9000 once NPM is
# in front of it. Setting this replaces the shipped RFC1918 defaults, which is
# what you want: the broader list would also trust anything reaching authentik
# over the LAN directly.
#
# This is a CIDR, not a secret, but the value below is a PLACEHOLDER -- it is
# not the real subnet on your host. Replace it with:
#     docker network inspect npm-net --format '{{ .IPAM.Config[0].Subnet }}'
AUTHENTIK_TRUSTED_PROXY_CIDRS=172.20.0.0/16
