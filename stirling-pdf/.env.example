# Stirling-PDF -- self-hosted PDF toolkit
#
# Setup:
#   1. cp .env.example .env
#   2. docker compose up -d
#   3. Log in as admin / stirling and change the password immediately,
#      unless you turned login off below.
HOST_IP=changeme

STIRLING_CONTAINER_NAME=stirling-pdf
STIRLING_PORT=8082

# Login is ON by default (admin / stirling on first boot). Set to false for
# a no-auth instance -- LAN-only, never exposed.
SECURITY_ENABLELOGIN=true
SYSTEM_DEFAULTLOCALE=en-US

# OAUTH
# SYSTEM_BACKENDURL="https://stirling-pdf.company"
# SECURITY_OAUTH2_ENABLED="true"
# SECURITY_OAUTH2_ISSUER="https://authentik.company/application/o/<application_slug>/"
# SECURITY_OAUTH2_CLIENTID="<Client ID from authentik>"
# SECURITY_OAUTH2_CLIENTSECRET="<Client Secret from authentik>"
# SECURITY_OAUTH2_PROVIDER="authentik"
