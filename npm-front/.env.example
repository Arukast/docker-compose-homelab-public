# First run these commands in shell to make the networks:
#   docker network create anubis-net npm-net
# =======================================================
# NPM-FRONT (TLS edge: wildcard certs + one vhost family -> anubis:8923)
# =======================================================
NPM_FRONT_CONTAINER_NAME=npm-front

# Host interface IP binding for the Admin Web UI (e.g. 10.40.0.10 or
# 127.0.0.1). Ports 80/443 intentionally listen on all interfaces: this
# container is the public edge. Admin UI: http://<HOST_IP>:82
# (first login: admin@example.com / changme -- change it immediately).
HOST_IP=changeme
