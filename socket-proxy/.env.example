# First running this command in shell to make the network: docker network create socket-proxy-net
# =======================================================
# NODE-SPECIFIC IDENTIFIER
# =======================================================
# Host interface IP binding (e.g., 10.40.0.10, 10.80.0.5, 100.64.0.10)
HOST_IP=changeme
DOCKER_SOCKET_PROXY_CONTAINER_NAME=docker-socket-proxy

# =======================================================
# GLOBAL BASELINE
# =======================================================
INFO=1             # Daemon details
VERSION=1          # API version
PING=1             # Health checks
EVENTS=1           # Live event stream
CONTAINERS=1       # List/view container status
NETWORKS=1         # Network inspection
STATS=1            # CPU/RAM usage metrics (HA, Homarr, Uptime Kuma)
LOGS=1             # Live container logs
AUTH=0             # HARDENING: Block auth API attempts
BUILD=0            # HARDENING: Block image builds
EXEC=0             # HARDENING: Block remote terminal execution
VOLUMES=0          # HARDENING: Block volume modification
SYSTEM=0           # HARDENING: Block host system prune commands

# =======================================================
# NODE-SPECIFIC WRITE ACCESS (Toggle per host function)
# =======================================================
# Set to 1 ONLY on nodes where HA/Homarr must start/stop containers
# Set to 0 on monitoring-only nodes
POST=0
ALLOW_START=0
ALLOW_STOP=0
ALLOW_RESTARTS=0
