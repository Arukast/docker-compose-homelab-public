# Requires the shared reverse-proxy network on the host (already exists on
# the proxy nodes): docker network create npm-net
# =======================================================
# ANUBIS (proof-of-work anti-scrape proxy in front of one service)
# =======================================================
ANUBIS_CONTAINER_NAME=anubis

# The service this instance guards (one Anubis per protected service),
# e.g. http://openwebui:8080 or http://it-tools:80. Must be reachable from
# anubis-net or npm-net (add the target's network to docker-compose.yml if
# it lives elsewhere).
ANUBIS_TARGET=changeme

# Hex-encoded ed25519 key (exactly 64 hex chars) used to sign challenge
# cookies. Generate with: openssl rand -hex 32
ANUBIS_ED25519_PRIVATE_KEY_HEX=changeme

# Serve a robots.txt that disallows all AI scrapers (true/false).
ANUBIS_SERVE_ROBOTS_TXT=true

# Proof-of-work difficulty (leading zeroes required in the answer).
# 4 = default, 3 = gentler on weak client devices.
ANUBIS_DIFFICULTY=4
