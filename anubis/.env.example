# First run these commands in shell to make the networks
# (docker network create takes ONE name at a time):
#   docker network create anubis-net
#   docker network create npm-net
# =======================================================
# ANUBIS (global proof-of-work gateway -- ONE instance in front of the router)
# =======================================================
# The router behind the gateway, e.g. http://nginx-proxy-manager:80 (NPM's
# service/container name on npm-net). Anubis does not care about the Host
# header: one instance covers every website the router serves. Per-service
# exceptions (API/mobile/webhook clients) live in anubis/policy.yaml.
ANUBIS_TARGET=changeme

# Hex-encoded ed25519 key (exactly 64 hex chars) used to sign challenge
# cookies. Generate with: openssl rand -hex 32
ANUBIS_ED25519_PRIVATE_KEY_HEX=changeme

# Base domain (no port) -- one challenge-pass cookie covers every
# subdomain, e.g. domain.com covers app.domain.com and x.dev.domain.com.
ANUBIS_COOKIE_DOMAIN=changeme

# Serve a robots.txt that disallows all AI scrapers (true/false).
ANUBIS_SERVE_ROBOTS_TXT=true

# Proof-of-work difficulty (leading zeroes required in the answer).
# 4 = default, 3 = gentler on weak client devices.
ANUBIS_DIFFICULTY=4

# Optional container name override.
# ANUBIS_CONTAINER_NAME=anubis
